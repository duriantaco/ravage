{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/schemas/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "generic",
          "path": "packages/schemas/src/pentest_schemas/_version.py"
        },
        {
          "type": "generic",
          "path": "packages/ravage/src/ravage/_version.py"
        },
        {
          "type": "generic",
          "path": "packages/ravage/pyproject.toml"
        },
        {
          "type": "generic",
          "path": "CITATION.cff"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "docs/how-to-use.md"
        },
        {
          "type": "generic",
          "path": "docs/index.md"
        },
        {
          "type": "generic",
          "path": "docs/setup.md"
        },
        {
          "type": "generic",
          "path": "packages/ravage/README.md"
        }
      ]
    }
  }
}
